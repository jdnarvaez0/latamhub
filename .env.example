# Copy this file to .env.local and fill in the values from your Supabase project dashboard.
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Required only for the ingest-startups.ts script (bypasses RLS to write data).
# Find it at: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
